# Bases de datos (contienen datos privados)
*.db
*.db-shm
*.db-wal

# Entorno virtual
venv/
venv-cohere/
venv-parakeet/
venv-rag/
venv-video/
venv-music/
env/
.env

# Modelos descargados (pesados)
models/

# Salida de transcripciones / grabaciones (pesadas)
output/
output_video/
output_cohere/
output_parakeet/
output_radio/

# Backups y M3U de pruebas locales
*.m3u.bak-*
local.m3u

# Cache de snapshots/clips de video generados on-demand
alerts/cache/

# Reportes .xlsx generados por /export en segundo plano (ver
# alerts/app.py:_run_export_job) -- salida efímera, no código.
export_files/

# Descargas parciales de YouTube en curso
tmp_youtube/

# Prototipos de refuerzo de vocabulario (ver proto_boosting/) -- se
# conservan los scripts (documentan cómo se validó la función real), pero
# no los audios de prueba (clips extraídos de grabaciones reales) ni logs.
proto_boosting/*.wav
proto_boosting/*.log

# Logs
logs/

# Caché Python
__pycache__/
*.pyc
*.pyo

# Claude Code
.claude/

# Archivos temporales / basura
lavas
files (1).zip
epg_channels.txt
playlist2.m3u

# Windows
Thumbs.db
Desktop.ini
