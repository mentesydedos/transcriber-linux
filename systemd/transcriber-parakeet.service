[Unit]
Description=Transcriber Radio FM 24x7 (Parakeet-TDT) - Solo canales 27+ (radio); TV la cubre transcriber-ctc-es.service
After=network-online.target
Wants=network-online.target
# No correr junto con el servicio Qwen: comparten GPU y la misma base de datos.
# SI puede correr junto con transcriber-ctc-es.service: canales distintos
# (ver TRANSCRIBER_CHANNEL_ID_MIN abajo).
Conflicts=transcriber.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=transcriber
Group=transcriber
WorkingDirectory=/home/transcriber/transcriber-linux
Environment="PATH=/home/transcriber/transcriber-linux/venv-parakeet/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="HF_HOME=/home/transcriber/transcriber-linux/models"
Environment="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"
# Motor Parakeet (transcriber_parakeet.py) en vez de Qwen
Environment="TRANSCRIBER_ENGINE=parakeet"
# Batch de inferencia GPU. Subido de 4 a 8 tras el cambio T1000 8GB -> RTX 4070 12GB.
# NOTA 2026-09-09: se probó bajarlo a 4 durante un incidente de OOM al
# arrancar radio junto con TV -- NO tuvo ningún efecto (mismo error, misma
# cifra de memoria). Confirmado en transcriber_parakeet.py: GPU_BATCH_SIZE
# solo se usa para agrupar inferencias YA con el modelo cargado, no afecta
# model.to("cuda") (el paso que realmente tronaba). Revertido a 8 -- el
# problema real es el margen de memoria total con TV corriendo (~1GB de
# sobra contra ~4.9GB que necesita el único worker de radio), no el batch.
Environment="TRANSCRIBER_PARAKEET_BATCH=8"
# Fuente TVHeadend (misma que usaba Qwen). Cambiar a local.m3u tras el cutover.
Environment="TRANSCRIBER_M3U=TV audio.m3u"
# .txt/.srt de transcripción: sin override aquí a propósito -- default local
# ("output/") en transcriber_parakeet.py. Se intentó separar TV/radio al NAS
# el 2026-08-06 (TRANSCRIBER_OUTPUT_DIR/_RADIO) pero el NAS resultó tener una
# falla de hardware -- ver nota igual de larga en
# systemd/transcriber-video-recorder.service. El soporte para el split queda
# en el código (transcriber_parakeet.py), listo para reactivarse por env
# cuando el NAS esté confiable, sin tocar código de nuevo.
# M3U: 26 canales de TV (TVHeadend) + 32 estaciones de radio FM de la ZMG por
# streaming directo (agregadas 2026-08-06/2026-08-11, posiciones 27-58 del M3U)
# + 6 estaciones de radio AM de noticias/hablado de mayor audiencia de la ZMG
# (agregadas 2026-08-11, posiciones 59-64 -- ver docs/am_noticias_zmg.md;
# Radio María quedó fuera a pedido explícito, y W Deportes 1010 quedó fuera
# porque el mount respondía "Stream is Offline" al momento de integrar --
# revisar y agregar después si vuelve a transmitir). Mismo worker.py, ffmpeg
# no distingue la fuente. Algunas (Zeno.fm) necesitan un header Origin/Referer
# -- ver #EXTHEADER en el M3U y manager.py:parse_m3u.
# Default de manager.py es 8: sin esto trunca la lista.
Environment="TRANSCRIBER_MAX_CHANNELS=64"
# Largo de chunk. 30s es lo maximo confiable con este stream (se corta ~cada 60s).
# Subir requiere primero estabilizar el stream. Ver TRANSCRIBER_CHUNK_SEC en worker.py.
Environment="TRANSCRIBER_CHUNK_SEC=30"
# TV (1-26) la cubre transcriber-ctc-es.service desde 2026-08-11 -- Parakeet-TDT
# derivaba a inglés en 3-40% de los chunks de TV (medido en producción), CTC-ES
# dio 0-0.2%. Este servicio se queda solo con radio (27+). En FM musical (27-58)
# el "inglés" medido resultó ser letras de canciones reales sonando, no un error
# del modelo (verificado leyendo el texto -- coincide con canciones conocidas:
# Karma Police, Autumn Sweater, etc.) -- ahí NO hace falta CTC-ES.
# Las 6 AM nuevas (59-64) son de noticias/deportes/salud HABLADO, mismo perfil
# de contenido que la TV que sí tuvo el problema real -- pendiente medir su
# code-switching tras unas horas en producción (misma heurística ya usada) y
# decidir si también necesitan moverse a transcriber-ctc-es.service.
# Rango numérico en vez de nombres -- ver CHANNEL_ID_MIN/MAX en manager.py.
Environment="TRANSCRIBER_CHANNEL_ID_MIN=27"
# Gate anti-OOM: no arranca hasta confirmar que TV (transcriber-ctc-es.service)
# está realmente produciendo transcripciones -- ver gpu_startup_gate.py. Si
# ambos motores se caen juntos, esto evita que Restart=always de systemd los
# vuelva a levantar en paralelo (el mismo escenario del incidente de OOM).
# Solo stdlib, corre con el python del sistema, sin depender de venv-parakeet.
ExecStartPre=/usr/bin/python3 /home/transcriber/transcriber-linux/gpu_startup_gate.py
ExecStart=/home/transcriber/transcriber-linux/venv-parakeet/bin/python manager.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# Parakeet tarda ~15s en cargar
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
