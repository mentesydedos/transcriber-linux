[Unit]
Description=Transcriber Radio 24x7 - Grabacion de audio en bloques de 30 min (38 estaciones), respaldado al NAS
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=transcriber
Group=transcriber
WorkingDirectory=/home/transcriber/transcriber-linux
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
# El disco local es solo un buffer de paso -- backup-nas2-radio.timer sube
# cada bloque al NAS y lo borra de aquí en cuanto ya quedó ahí (ver
# backup_nas2_radio.py). No hace falta retención local como en video.
Environment="TRANSCRIBER_RADIO_DIR=/home/transcriber/transcriber-linux/output_radio"
Environment="TRANSCRIBER_RADIO_SEGMENT_SEC=1800"
# AAC 96kbps -- mismo bitrate que ya usa el audio de TV (video_recorder.py).
Environment="TRANSCRIBER_RADIO_ABITRATE=96k"
# Ventana nocturna sin grabar 00:00-05:30, igual que video_recorder.py.
ExecStart=/usr/bin/python3 /home/transcriber/transcriber-linux/radio_recorder.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
