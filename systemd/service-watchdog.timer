[Unit]
Description=Corre service-watchdog.service cada 15 minutos

[Timer]
# 15min tras el boot -- da margen a que alertatv-startup.service (hasta
# 10min, TimeoutStartSec=600) termine su arranque escalonado antes de la
# primera medicion, para no reportar falsos "caido" durante el arranque.
OnBootSec=15min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
